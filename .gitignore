# Environment & Secrets
.env
config.env.local

# Dynamic Scrum State & Workspace
state/*
!state/.gitkeep
workspace/
coverage_sprint*.out

# User Reference Files (Ignore user additions, keep repository defaults)
references/*
!references/.gitkeep
!references/GEMINI.md
!references/go_clean_architecture.md
!references/icon_generator.md

# Python Cache
__pycache__/
*.pyc
.venv/
./engine/__pycache__/*.pyc
./runner/__pycache__/*.pyc

state/initiatives/epic_*
state/.evaluator/latest_*
state/.evaluator/refinement_audit_report.md
state/execution_tracker.json
workspace/avatar-service/*
!workspace/avatar-service/.gitkeep
!state/initiatives/.gitkeep
/tmp/*

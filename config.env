# ==============================================================================
# Loop AI Lab - System Environment Configuration
# ==============================================================================

# Target Project & Workspace Settings
PROJECT_NAME=identicon-generator
TARGET_DIR=workspace/identicon-generator
WORKSPACE_REL=workspace/identicon-generator
CONTAINER_IMAGE_NAME=identicon-generator
REQUIREMENT_FILE=references/icon_generator.md
LANGUAGE=go

# Commands
TEST_COMMAND=go test ./...
RUN_COMMAND=go run .
VERIFY_COMMAND=go test ./...
DEV_RULES_PATH=.agents/rules/development/

# LLM Provider Configuration ("local" | "gemini" | "claude" | "ollama")
DEFAULT_LLM_PROVIDER=local
REFINEMENT_PROVIDER=local
EVALUATOR_PROVIDER=local
EXECUTOR_PROVIDER=local

# Local LLM Endpoints & Parameters
LOCAL_LLM_ENDPOINT=http://127.0.0.1:11435/v1/chat/completions
LOCAL_LLM_COMPLETION_ENDPOINT=http://127.0.0.1:11435/completion
EXECUTOR_ENDPOINT=http://127.0.0.1:11435/v1/chat/completions
EXECUTOR_MODEL=Devstral-Small-2-24B-Instruct
LLAMA_MAX_TOKENS=4096
LLAMA_TEMPERATURE=0.2

# Pipeline Execution Control
MAX_RETRIES=3
MAX_LOOPS=20
REVIEW_INTERVAL=3
MAX_HARNESS_FAILS=5
STOP_ON_SUCCESS=false

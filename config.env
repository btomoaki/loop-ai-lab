# loop-ai-lab システム環境設定

# タスク識別とアクティブポリシー設定
# 利用可能なタスクタイプ: "infra_setup", "feature_dev", "observability"
ACTIVE_TASK_TYPE="feature_dev"

# 開発ターゲットディレクトリと要件定義ファイル
PROJECT_NAME="identicon-generator"
TARGET_DIR="workspace/identicon-generator"
WORKSPACE_REL="workspace/identicon-generator"
CONTAINER_IMAGE_NAME="identicon-generator"
REQUIREMENT_FILE="references/icon_generator.md"
PROGRESS_FILE="PROGRESS.md"
EVALUATION_LOG_FILE="workspace/logs/EVALUATION_LOG.md"
LANGUAGE="go"

# ハーネス検証コマンド
TEST_COMMAND="go test ./..."
RUN_COMMAND="go run ."
VERIFY_COMMAND="go test ./..."
DEV_RULES_PATH=".agents/rules/development/"

# 自律ループの最大試行回数
MAX_LOOPS=20

# 評価履歴の振り返り参照ステップ数
REVIEW_INTERVAL=3

# AI モデル & プロバイダ設定
EVALUATOR_PROVIDER="gemini"
EVALUATOR_MODEL="gemini-3.7-flash-low"

EXECUTOR_PROVIDER="llama_cpp"
EXECUTOR_MODEL="mistralai_Devstral-Small-2-24B-Instruct-2512-Q4_K_M.gguf"
LOCAL_LLM_URL="http://127.0.0.1:11435/completion"
LOCAL_LLM_ENDPOINT="http://127.0.0.1:11435/v1/chat/completions"
LOCAL_LLM_COMPLETION_ENDPOINT="http://127.0.0.1:11435/completion"
EXECUTOR_ENDPOINT="http://127.0.0.1:11435/v1/chat/completions"
LLAMA_MAX_TOKENS=8192

STOP_ON_SUCCESS=false

# Refinement Provider Configuration (Cloud High-Capacity LLM Only)
REFINEMENT_PROVIDER="local"
REFINEMENT_MODEL="gemini-3.7-flash-low"

MAX_HARNESS_FAILS=5
MAX_RETRIES=3

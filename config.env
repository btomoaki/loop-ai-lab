# ==============================================================================
# loop-ai-lab Configuration
# ==============================================================================

# ターゲットリポジトリのパス (絶対パスまたは本ディレクトリルートからの相対パス)
TARGET_DIR="./workspace/helm-app"

# 共通インフラ基盤 (local-setup) のパス
LOCAL_SETUP_DIR="../local-setup"

# 達成すべき要件・タスク定義ファイル
REQUIREMENT_FILE="./requirements.sample.md"

# タスク種別 (政策/ポリシーの動的選択用: "feature_dev", "bugfix", "infra_setup", "observability" 等)
TASK_TYPE="infra_setup"

# 進捗トラッキングファイル (タスク一覧・進捗状態)
PROGRESS_FILE="./PROGRESS.md"

# 判断ブレ蓄積ログファイルパス (Git管理外の logs/ 配下)
EVALUATION_LOG_FILE="./logs/EVALUATION_LOG.md"

# AIプロンプトに注入する直近の判断履歴件数
HISTORY_CONTEXT_COUNT=3

# 何ループごとに仕様脱線・方向性監査 (Alignment Audit) を挟むか
REVIEW_INTERVAL=10

# 自律ループの最大試行回数 (連続成功または最大回数で終了)
MAX_LOOPS=5

# ターゲット側で実行する検証コマンド (Go, Helm, Docker, IaC 等なんでも可)
VERIFY_COMMAND="~/.local/bin/helm lint . && ~/.local/bin/helm template ."

# ==============================================================================
# LLM Providers & Adapters Configuration
# ==============================================================================

# 評価・指示・監査担当 (Evaluator / Auditor)
# プロバイダ選択: "gemini", "claude", "local_ollama", "openai"
# ※ "gemini" は agy CLI 経由のため ANTHROPIC_API_KEY 不要。claude モデルも指定可能。
EVALUATOR_PROVIDER="gemini"
EVALUATOR_MODEL="claude-sonnet-4-6"

# 実装・コード書き換え担当 (Executor)
# プロバイダ選択: "local_ollama", "llama_cpp", "gemini", "openai"
EXECUTOR_PROVIDER="llama_cpp"
EXECUTOR_MODEL="qwen2.5-coder-32b-instruct-q4_k_m"
LOCAL_LLM_URL="http://127.0.0.1:11435"
# llama-server の起動コンテキストは起動スクリプト内の LLAMA_CTX 変数で制御 (scripts/llama-start-*.bat)
# 以下は per-request の出力トークン数制御
LLAMA_MAX_TOKENS=4096
# OLLAMA_NUM_CTX は不要 - llama-server 起動時の -c オプションで制御 (e.g. -c 32768)
# OLLAMA_NUM_CTX=6144

# SOPS / クレデンシャル管理の設定
# ENABLE_SOPS=true にするとSOPSによる暗号・復号チェックを統合
ENABLE_SOPS=false
SOPS_AGE_KEY_FILE="~/.config/sops/age/keys.txt"
